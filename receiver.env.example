# wt-receiver 环境变量示例。复制为 receiver.env（服务器上为 /opt/wt-receiver/receiver.env，权限 600），替换占位值。
# 采集端 wt-collector.toml 中的 token 必须与 WT_TOKEN 一致。生成：openssl rand -hex 24
WT_TOKEN=CHANGE_ME_WT_TOKEN
# HK 服务器上只监听本机，由 Caddy 反代（https://wt.zuens2020.top）
WT_BIND=127.0.0.1:18111
WT_DATA=/var/lib/wt-receiver/data
# 容量保护：数据目录超过 WT_MAX_GB 或磁盘剩余低于 WT_MIN_FREE_GB 时返回 507，采集端暂存
WT_MAX_GB=25
WT_MIN_FREE_GB=5
# 海战过滤：逗号分隔（大小写不敏感）。WT_NAVAL_ICONS 替换默认列表，*_EXTRA 追加
WT_NAVAL_ICONS=ship,boat,torpedoboat,gunboat,destroyer,frigate,lightcruiser,heavycruiser,cruiser,battlecruiser,battleship,submarine,aircraftcarrier,carrier,barge,navalferrybarge,minelayer,minesweeper,corvette,patrolboat
WT_NAVAL_TYPE_SUBSTR=ship,boat,naval
WT_NAVAL_ICONS_EXTRA=
WT_KNOWN_ICONS_EXTRA=
# 时钟守卫：服务器校正时间戳与接收时间相差超过该值（ms）的记录丢弃
WT_MAX_SKEW_MS=3000
# 无时钟同步的旧采集端：auto = 仅接受 < 0.1.5 版本（标记 legacy）；on / off
WT_ACCEPT_LEGACY=auto
